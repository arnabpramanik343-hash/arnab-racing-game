
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ARNAB RACING</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;background:#101522;color:white;
 text-align:center;font-family:Arial;
}
h2{color:#00e5ff;margin:10px}
#score{font-size:20px;color:#ffe600}
canvas{
 background:#444;width:min(100vw,400px);
 height:auto;border:3px solid white;
 display:block;margin:auto;
}
.controls{
 display:flex;justify-content:center;
 gap:35px;margin:12px;
}
button{
 padding:14px 32px;border:0;
 border-radius:12px;background:#087cff;
 color:white;font-size:22px;
}
#restart{background:#00a65a;font-size:17px}
</style>
</head>
<body>

<h2>🏎️ ARNAB RACING</h2>
<div id="score">SCORE: 0</div>

<canvas id="game" width="360" height="560"></canvas>

<div class="controls">
<button id="left">⬅️</button>
<button id="right">➡️</button>
</div>
<button id="restart">RESTART</button>

<script>
const canvas=document.getElementById("game");
const ctx=canvas.getContext("2d");

let player={x:156,y:445,w:48,h:85};
let enemies=[];
let score=0,frame=0,line=0;
let direction=0,over=false;

function drawCar(x,y,color,name){
 ctx.fillStyle="#111";
 ctx.fillRect(x-4,y+15,6,18);
 ctx.fillRect(x+46,y+15,6,18);
 ctx.fillRect(x-4,y+62,6,18);
 ctx.fillRect(x+46,y+62,6,18);

 ctx.fillStyle=color;
 ctx.fillRect(x,y,48,85);

 ctx.fillStyle="#a9edff";
 ctx.fillRect(x+8,y+12,32,20);
 ctx.fillRect(x+8,y+54,32,15);

 ctx.fillStyle="white";
 ctx.font="bold 9px Arial";
 ctx.textAlign="center";
 ctx.fillText(name,x+24,y+43);
}

function drawRoad(){
 ctx.fillStyle="#444";
 ctx.fillRect(0,0,360,560);

 ctx.fillStyle="#fff";
 ctx.fillRect(12,0,5,560);
 ctx.fillRect(343,0,5,560);

 for(let y=-100;y<600;y+=110){
 ctx.fillRect(117,y+line,5,55);
 ctx.fillRect(238,y+line,5,55);
 }
 if(!over) line=(line+6)%110;
}

function spawn(){
 let lanes=[40,155,275];
 enemies.push({
 x:lanes[Math.floor(Math.random()*3)],
 y:-100,
 color:["red","yellow","purple"][Math.floor(Math.random()*3)]
 });
}

function hit(a,b){
 return a.x<b.x+48 && a.x+48>b.x &&
 a.y<b.y+85 && a.y+85>b.y;
}

function update(){
 if(over)return;

 frame++;
 score++;
 document.getElementById("score").textContent="SCORE: "+score;

 player.x+=direction*5;
 player.x=Math.max(20,Math.min(292,player.x));

 if(frame%65===0)spawn();

 enemies.forEach(e=>{
 e.y+=5+Math.min(score/1000,4);
 if(hit(player,e))over=true;
 });
 enemies=enemies.filter(e=>e.y<600);
}

function draw(){
 drawRoad();

 enemies.forEach(e=>drawCar(e.x,e.y,e.color,"RIVAL"));

 drawCar(player.x,player.y,"#008cff","ARNAB");

 if(over){
 ctx.fillStyle="rgba(0,0,0,.85)";
 ctx.fillRect(0,0,360,560);
 ctx.fillStyle="white";
 ctx.textAlign="center";
 ctx.font="bold 32px Arial";
 ctx.fillText("GAME OVER",180,245);
 ctx.font="20px Arial";
 ctx.fillText("ARNAB SCORE: "+score,180,290);
 ctx.fillText("Press RESTART",180,330);
 }
}

function loop(){
 update();
 draw();
 requestAnimationFrame(loop);
}

function control(id,value){
 const btn=document.getElementById(id);
 btn.addEventListener("pointerdown",e=>{
 e.preventDefault();direction=value;
 });
 btn.addEventListener("pointerup",()=>direction=0);
 btn.addEventListener("pointerleave",()=>direction=0);
 btn.addEventListener("pointercancel",()=>direction=0);
}

control("left",-1);
control("right",1);

document.getElementById("restart").onclick=()=>{
 player.x=156;
 enemies=[];
 score=0;frame=0;line=0;
 over=false;direction=0;
};

loop();
</script>
</body>
</html>

